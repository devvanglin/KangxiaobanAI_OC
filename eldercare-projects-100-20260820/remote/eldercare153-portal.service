[Unit]
Description=Eldercare 153 deployment and acceptance portal
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=node2
Group=node2
WorkingDirectory=/opt/eldercare100
Environment=HOME=/opt/eldercare100/private/home
Environment=ELDERCARE_PUBLIC_HOST=127.0.0.1
ExecStart=/usr/bin/python3 -u /opt/eldercare100/tools/portal.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/eldercare100

[Install]
WantedBy=multi-user.target
