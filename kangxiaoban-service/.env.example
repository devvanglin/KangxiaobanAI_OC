# 服务端口
KXB_SERVER_PORT=8080

# 应用版本（监控页展示；不设置则用构建注入值，本地开发默认 dev）
# KXB_APP_VERSION=2.3.8
# 部署模式（监控页展示）：production=生产环境 / demo=演示模式 / dev=开发环境
# 不设置则跟随 Gin 运行模式（GIN_MODE=release 时显示生产环境）
# KXB_DEPLOY_MODE=demo
# Gin 运行模式：release=生产（关闭调试日志），不设置=开发模式
# GIN_MODE=release

# 数据库驱动：开发 sqlite（无外部依赖）/ 生产 mysql
KXB_DB_DRIVER=sqlite
# 驱动 = sqlite 时使用的文件
KXB_DB_SQLITE_PATH=kangxiaoban.db
# 办理入住照片的私有存储目录（不要放在静态资源目录下）
KXB_UPLOAD_DIR=uploads
# 驱动 = mysql 时的 DSN（生产）
# KXB_DB_MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/kangxiaoban?charset=utf8mb4&parseTime=True&loc=Local

# JWT 密钥（生产必须换成随机强密钥，不要提交真实值）
KXB_JWT_SECRET=change-me-in-production
# token 有效期（秒）
KXB_JWT_EXPIRE=86400

# MQTT 物联网接入（雷达等设备）
KXB_MQTT_ENABLE=true
KXB_MQTT_URL=tcp://10.10.1.14:1883
KXB_MQTT_CLIENT_ID=kxb-backend
# 若 Broker 需认证再填
# KXB_MQTT_USERNAME=
# KXB_MQTT_PASSWORD=

# 业务初始数据（首次空库自动生成相互关联的设备、告警、账单等记录）
# 真实机构部署建议 false；true 仅用于本地演示数据
KXB_SEED_BUSINESS=false

# AI 对话网关：provider=local(内置确定性答复,离线可用) / http(接OpenAI兼容模型)
# 模型服务（NewAPI/vLLM 等 OpenAI 兼容端点）与 Dify RAG 知识库的地址和密钥
# 一律只保存在服务端 .env，客户端永远无法读取或修改（与 MinIO 同款）。
KXB_AI_ENABLED=true
KXB_AI_PROVIDER=local
# provider=http 时必须配置：
# KXB_AI_BASE_URL=http://your-newapi-or-vllm:9999
# KXB_AI_MODEL=your-default-model
# KXB_AI_API_KEY=sk-xxx
# DGX 人脸/表情/行为识别服务（InsightFace + EmotiEffLib + JoyAI）。
# 入住人像照注册与摄像头行为分析依赖此服务（HTTPS 自签证书）。
KXB_FACE_ENABLED=true
# KXB_FACE_SERVICE_URL=https://10.10.1.1:8088
# Dify RAG 知识库（检索 + 管理端知识库代理）。三者都配置后聊天检索才生效。
# KXB_DIFY_BASE_URL=http://your-dify-host
# KXB_DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# KXB_DIFY_API_KEY=dataset-api-key
# 管理端保存到数据库的 AI 密钥（角色分配/MCP 服务器）加密密钥（生产必须显式注入）
# KXB_AI_CONFIG_KEY=replace-with-a-dedicated-secret
KXB_ASSESSMENT_AGENT_WS_URL=ws://10.10.1.11:8000/assessment-ws
# Generate a random value and keep the same value only in the backend .env
# and the protected AsLive systemd environment file.
KXB_ASSESSMENT_AGENT_TOKEN=

# Optional isolated shell/file tools for the AI Agent. These execute only in
# OpenSandbox containers, never on the Kangxiaoban host.
KXB_SANDBOX_ENABLED=false
KXB_SANDBOX_DOMAIN=127.0.0.1:18081
KXB_SANDBOX_PROTOCOL=http
KXB_SANDBOX_API_KEY=replace-with-opensandbox-server-key
KXB_SANDBOX_IMAGE=python:3.12-slim

# MinIO/S3 对象存储（管理端「存储」预览）。密钥只放服务器 .env，不进镜像不进代码。
# KXB_MINIO_ENDPOINT=10.10.1.13:9000
# KXB_MINIO_ACCESS_KEY=
# KXB_MINIO_SECRET_KEY=
# KXB_MINIO_SECURE=false
# KXB_MINIO_REGION=

# 摄像头 RTSP→HLS 转码预览（依赖服务器安装 ffmpeg，命令行加入 PATH 即可）
KXB_STREAM_ENABLED=true
# ffmpeg 可执行文件路径；为空则使用 PATH 中的 ffmpeg
# KXB_FFMPEG_PATH=/usr/local/bin/ffmpeg
# HLS 分片输出根目录
KXB_STREAM_DIR=streams
# 预览令牌有效期（秒）
KXB_STREAM_TOKEN_TTL_SECONDS=7200
# 会话空闲回收时间（秒）：停止预览一段时间后自动杀掉 ffmpeg
KXB_STREAM_IDLE_TTL_SECONDS=120
